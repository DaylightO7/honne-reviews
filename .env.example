# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/web_review_hub

# Express Session Encryption Secret
SESSION_SECRET=honne_reviews_super_secure_session_secret_change_me

# Cloudinary Cloud Storage Credentials (Required for persistent images & avatars)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
